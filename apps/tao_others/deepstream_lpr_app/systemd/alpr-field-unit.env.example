ALPR_DASHBOARD_HOST=0.0.0.0
ALPR_DASHBOARD_PORT=8080

# Enable Panda PAU0B/MT7610U WiFi at boot: Verizon hotspot client plus
# direct ALPR access point. The Verizon NetworkManager profile already exists
# on C5-unit1 as Verizon-MiFi8800L-AA46.
ALPR_PANDA_WIFI_ENABLE=1
ALPR_VERIZON_WIFI_PROFILE=Verizon-MiFi8800L-AA46
ALPR_WIFI_AP_INTERFACE=alpr_ap0
ALPR_WIFI_AP_SSID=C5_Unit1
ALPR_WIFI_AP_PASSWORD=10851aVC

# Optional direct Ethernet sharing for an operator laptop.
# ALPR_ETHERNET_SHARE_ENABLE=1
# ALPR_ETHERNET_INTERFACE=enp2s0